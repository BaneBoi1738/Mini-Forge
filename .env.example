# Copy to .env and fill in. Never commit .env.

# Which LLM backend the gateway uses:
#   mock          - no API key needed; a deterministic scripted "model" (pipeline test only)
#   anthropic     - Anthropic API (ANTHROPIC_API_KEY)
#   bedrock       - Claude on AWS Bedrock (uses your AWS credentials / profile)
#   openai_compat - any OpenAI-compatible endpoint: Gemini free tier, Groq, OpenRouter, OpenAI...
LLM_PROVIDER=mock

# Model name for the chosen provider (must have a price in config/pricing.yaml for cost tracking)
LLM_MODEL=mock-triage-v1

# --- anthropic ---
ANTHROPIC_API_KEY=

# --- bedrock ---
AWS_REGION=us-east-1
# AWS_PROFILE=default
# LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- openai_compat (examples) ---
# Gemini free tier (key from aistudio.google.com; use the current Flash model name):
#   OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash
#   OPENAI_COMPAT_REASONING_EFFORT=low     # keeps thinking tokens (and cost) small
#   MAX_OUTPUT_TOKENS=2048
# Groq free tier:
#   OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_REASONING_EFFORT=

# Max output tokens per model call (reserved in the per-run token budget check)
MAX_OUTPUT_TOKENS=1024

# Seconds to wait between letters (helps with free-tier rate limits)
SLEEP_BETWEEN_DOCS=0
